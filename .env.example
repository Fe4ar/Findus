# Copy to .env and fill each secret with: openssl rand -hex 32
# Name or IP the browser uses for Findus; further names (e.g. behind a reverse proxy) in WIKI_ALIASES.
WIKI_HOST=localhost
WIKI_ALIASES=
# Address of a reverse proxy in front of Findus (default: private ranges).
TRUSTED_PROXIES=private_ranges
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
ONLYOFFICE_JWT_SECRET=
# Max upload size in MB
MAX_UPLOAD_MB=200
