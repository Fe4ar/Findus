# Copy to .env and fill each secret with: openssl rand -hex 32
# Name or IP the browser uses for Findus; further names (e.g. behind a reverse proxy) in WIKI_ALIASES.
WIKI_HOST=localhost
WIKI_ALIASES=
# Address of a reverse proxy in front of Findus (default: private ranges).
TRUSTED_PROXIES=private_ranges
# Optional: own host name of the help portal for people without an account (only /hilfe and /api/public are served there).
# It must resolve to this server (DNS or reverse proxy); the portal is also reachable at https://<WIKI_HOST>/hilfe/ without it.
PUBLIC_HOST=
# Optional: Fernet key for the stored Todoist tokens (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Without it a key is derived from DJANGO_SECRET_KEY; changing either makes stored tokens unreadable (users reconnect).
INTEGRATION_KEY=
# Optional: address of Findus in links that leave it (Todoist task -> Findus task); default https://<first WIKI_ALIASES or WIKI_HOST>
FINDUS_URL=
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
ONLYOFFICE_JWT_SECRET=
# Max upload size in MB
MAX_UPLOAD_MB=200
